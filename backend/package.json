{
  "name": "url-shortener-backend",
  "version": "1.0.0",
  "description": "URL Shortener backend API",
  "main": "src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node src/server.js",
    "lint": "eslint \"src/**/*.js\" \"../frontend/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.js\" \"../frontend/**/*.js\"",
    "test": "jest --coverage",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "eslint": "^10.15.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "supertest": "^6.3.3"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/src/test/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/test/**"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 75,
        "branches": 50,
        "functions": 75,
        "lines": 75
      }
    }
  }
}
